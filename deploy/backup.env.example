# Copy to /etc/ideaflow/backup.env on the VPS, owned by root, mode 600.
# Enter real values only in that private VPS file; never commit it.
# Use the dedicated PRIVATE ideaflow-backups bucket, not a public media bucket.
IDEAFLOW_BACKUP_R2_ENDPOINT=
IDEAFLOW_BACKUP_R2_ACCESS_KEY_ID=
IDEAFLOW_BACKUP_R2_SECRET_ACCESS_KEY=
# Telegram alerts and independent missed-run monitoring are deferred.
