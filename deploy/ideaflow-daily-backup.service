[Unit]
Description=IdeaFlow database and local media backup to private R2
Wants=network-online.target
After=network-online.target mysql.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/www/pos
UMask=0077
EnvironmentFile=/etc/ideaflow/backup.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/bash /var/www/pos/scripts/run_daily_backup.sh --scheduled
TimeoutStartSec=30min
TimeoutStopSec=30s
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
