# ============================================================
# IdeaHub -- Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git -- only commit .env.example
# ============================================================

# --- Flask Core ---
FLASK_ENV=production
SECRET_KEY=your_super_secret_key_minimum_32_characters_long

# --- Database (MySQL) ---
# Hostinger VPS local MySQL:
DATABASE_URL=mysql+pymysql://ideauser:yourpassword@localhost/ideahub

# --- CORS Origins ---
# Comma-separated list of allowed origins (no trailing slashes)
# Production:  https://idea-flows.online,https://www.idea-flows.online
# Development: http://localhost:5000
CORS_ORIGINS=https://idea-flows.online,https://www.idea-flows.online

# --- Upload Folder ---
# Absolute path where uploaded menu images are stored.
# VPS:         /var/www/ideahub/static/uploads/menu
# Development: leave blank (defaults to ./static/uploads/menu)
UPLOAD_FOLDER=/var/www/ideahub/static/uploads/menu

# --- Server Port ---
# Port gunicorn listens on (Nginx proxies to this port)
PORT=5000
