# ============================================================
# IdeaHub -- Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git -- only commit .env.example
# ============================================================

# --- Flask Core ---
FLASK_ENV=production
SECRET_KEY=your_super_secret_key_minimum_32_characters_long

# --- Database (MySQL) ---
# Hostinger VPS local MySQL:
DATABASE_URL=mysql+pymysql://ideauser:yourpassword@localhost/ideahub

# Required only while creating the first production admin. Remove this line
# after changing the generated admin password in the application.
INITIAL_ADMIN_PASSWORD=replace_with_a_unique_strong_password

# --- Shared coordination (required when running more than one app process) ---
# Used by Socket.IO broadcasts and Flask-Limiter counters.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_REQUIRED=true
CACHE_ENABLED=true
CACHE_DEFAULT_TIMEOUT=60
CACHE_KEY_PREFIX=ideahub
SOCKETIO_ASYNC_MODE=eventlet

# Tune the total across every app process below the MySQL connection limit.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=280

# --- CORS Origins ---
# Comma-separated list of allowed origins (no trailing slashes)
# Production:  https://idea-flows.online,https://www.idea-flows.online
# Development: http://localhost:5000
CORS_ORIGINS=https://idea-flows.online,https://www.idea-flows.online

# --- Upload Folder ---
# Absolute path where uploaded menu images are stored.
# VPS:         /var/www/ideahub/static/uploads/menu
# Development: leave blank (defaults to ./static/uploads/menu)
UPLOAD_FOLDER=/var/www/ideahub/static/uploads/menu

# Rotating application/security logs
LOG_DIR=/var/log/ideahub
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
SLOW_REQUEST_MS=1000

# The supplied systemd unit runs migration once before Gunicorn starts.
AUTO_MIGRATE_ON_STARTUP=false

# Number of trusted reverse proxies between clients and Flask (Nginx = 1).
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1

# --- Server Port ---
# Port gunicorn listens on (Nginx proxies to this port)
PORT=5000
